#!/bin/sh
set -eu
# binary hooks run after GRUB configuration generation and before ISO creation.
cfg="binary/boot/grub/grub.cfg"
if [ ! -s "$cfg" ]; then
  echo "Expected generated GRUB menu missing: $cfg" >&2
  exit 1
fi
# Preserve menu entries and boot parameters; change only the wait policy.
sed -i -E '/^[[:space:]]*set[[:space:]]+timeout(_style)?=/d' "$cfg"
{
  printf '\n# Nexus OS: boot default live entry automatically.\n'
  printf 'set default=0\n'
  printf 'set timeout_style=menu\n'
  printf 'set timeout=3\n'
} >> "$cfg"
grep -qx 'set timeout=3' "$cfg"
echo "Nexus OS GRUB menu timeout set to 3 seconds"
