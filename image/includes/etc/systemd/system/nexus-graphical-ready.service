[Unit]
Description=Nexus OS graphical stack readiness marker
After=display-manager.service graphical.target
Requires=display-manager.service
ConditionPathExists=/etc/nexus-os-release

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/local/libexec/nexus-graphical-ready
StandardOutput=journal+console
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
