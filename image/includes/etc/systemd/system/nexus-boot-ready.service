[Unit]
Description=Nexus OS live guest boot readiness marker
After=local-fs.target systemd-user-sessions.service
ConditionPathExists=/etc/nexus-os-release

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/local/libexec/nexus-boot-ready
StandardOutput=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
