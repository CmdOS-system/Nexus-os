#!/bin/sh
set -eu
i=0
while [ "$i" -lt 150 ]; do
  for marker in /run/user/[0-9]*/nexus-xfce-session-ready; do
    [ -f "$marker" ] || continue
    uid=${marker#/run/user/}
    uid=${uid%%/*}
    case "$uid" in *[!0-9]*|'') continue;; esac
    [ "$uid" -ne 0 ] || continue
    owner=$(stat -c %u "$marker") || continue
    [ "$owner" = "$uid" ] || continue
    grep -Fxq 'NEXUS_XFCE_SESSION_READY_V1' "$marker" || continue
    printf '%s\n' 'NEXUS_XFCE_SESSION_READY_V1' > /dev/ttyS0
    exit 0
  done
  sleep 1
  i=$((i+1))
done
echo "Nexus XFCE session evidence not found" >&2
exit 1
