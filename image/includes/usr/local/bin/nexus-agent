#!/usr/bin/env bash
set -euo pipefail

AGENT_DIR="/opt/nexus/agent"
if [ ! -d "$AGENT_DIR" ]; then
  printf '%s\n' "Nexus Agent is not installed in this image yet." >&2
  exit 1
fi

if [ -n "${NEXUS_AI_MODEL:-}" ]; then
  exec python3 "$AGENT_DIR/cli.py" --model "$NEXUS_AI_MODEL"
fi
exec python3 "$AGENT_DIR/cli.py"
